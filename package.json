{
  "name": "ai-ticket-it",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:backend": "npm start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:mobile": "npm start --workspace=mobile",
    "dev:mobile": "npm start --workspace=mobile",
    "start:dev": "concurrently \"npm run dev:backend\" \"npm run start:mobile\"",
    "test:backend": "npm test --workspace=backend",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AI Ticket It - Plataforma de Venta de Entradas para Eventos",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "prettier": "3.6.2"
  }
}
